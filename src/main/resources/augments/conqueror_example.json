{
    "id": "conqueror_example",
    "name": "Conqueror Example",
    "tier": "MYTHIC",
    "hook": "ON_HIT",
    "icon": "Ingredient_Void_Essence",
    "stackable": false,
    "enabled": false,
    "description": "Each consecutive hit increases your damage. At max stacks, deal bonus true damage.",
    "ui": {
        "vars": {
            "perStack":  { "path": "passives.buffs.bonus_damage.value",                          "fmt": "int" },
            "maxStacks": { "path": "passives.buffs.max_stacks",                                   "fmt": "int" },
            "flatTrue":  { "path": "passives.max_stack_bonus.bonus_true_damage.value",            "fmt": "int" },
            "pctTrue":   { "path": "passives.max_stack_bonus.bonus_true_damage.true_damage_percent", "fmt": "int" },
            "seconds":   { "path": "passives.duration.seconds",                                   "fmt": "int" }
        },
        "sections": [
            {
                "title": "Buffs",
                "body": "+{perStack}% damage per stack (max {maxStacks} stacks)\nAt max stacks: +{flatTrue} true damage + {pctTrue}% of base as true damage",
                "color": "#8adf9e"
            },
            {
                "title": "Duration",
                "body": "{seconds}s per stack",
                "color": "#9ecbff"
            }
        ]
    },
    "passives": {
        "buffs": {
            "bonus_damage": {
                "value": 5
            },
            "max_stacks": 8
        },
        "max_stack_bonus": {
            "bonus_true_damage": {
                "value": 50,
                "true_damage_percent": 3
            }
        },
        "duration": {
            "seconds": 8
        }
    },
    "mob_compatible": false
}
